# Quadlet unit untuk qouver-web — podman + systemd user (seragam majadu-api)
# Pasang di VPS: ~/.config/containers/systemd/qouver-web.container
# lalu: systemctl --user daemon-reload && systemctl --user enable --now qouver-web
# (pastikan: loginctl enable-linger sachiel — sudah yes di VPS)
[Unit]
Description=Qouver Web (qouver.com, static)
After=network-online.target
Wants=network-online.target
[Container]
Image=ghcr.io/nferdazel/qouver_web:main
ContainerName=qouver-web
Network=qouver
PublishPort=127.0.0.1:3002:80
AutoUpdate=registry
[Service]
Restart=always
RestartSec=3
[Install]
WantedBy=default.target
