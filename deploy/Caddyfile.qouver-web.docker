# Caddyfile untuk di DALAM container qouver-web (podman)
# Host Caddy (VPS) reverse_proxy 127.0.0.1:3002 → container :80
# Jadi container cuma file_server plain di :80, tanpa TLS, tanpa ACME
#
# Header kepemilikan: HOST Caddy yang punya semua security header + HSTS +
# Cache-Control. Container tidak boleh memasangnya lagi.
#
# Alasannya: dua header dengan nama sama tidak digabung oleh browser, mereka
# diiris (intersection), jadi salinan yang lebih ketat menang tanpa sinyal apa
# pun. Dulu keduanya memasang header, dan saat CSP host tertinggal satu versi,
# kebijakan basi itulah yang berlaku walau container sudah benar.
#
# Catatan: port container hanya di-publish ke 127.0.0.1:3002 (lihat
# qouver-web.container) dan firewall host cuma membuka http/https/ssh, jadi
# tidak ada jalur masuk selain host Caddy. Tidak ada alasan untuk header di
# sini.

:80 {
    root * /srv
    encode zstd gzip

    # Clean URLs: /projects → /projects/index.html tanpa 308 redirect
    try_files {path} {path}/index.html {path}.html

    file_server

    handle_errors {
        @404 expression {http.error.status_code} == 404
        rewrite @404 /404.html
        file_server
    }
}
